class UserError(ValueError):
    """A concise user-facing validation or workflow error."""


def note(message: str) -> None:
    print(f"[{TOOL_NAME}] {message}", file=sys.stderr, flush=True)


def environment_value(suffix: str) -> Optional[str]:
    """Prefer explicit overrides, then the installer's private tool paths."""

    primary = f"EUKBINPICKER_{suffix}"
    if primary in os.environ:
        return os.environ[primary]
    config = ROOT / "installation.json"
    if config.is_file():
        return json.loads(config.read_text()).get("environments", {}).get(suffix)
    return None


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wt", encoding="utf-8", newline="\n") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def open_text(path: Path) -> IO[str]:
    with path.open("rb") as handle:
        is_gzip = handle.read(2) == b"\x1f\x8b"
    if is_gzip:
        return gzip.open(path, "rt", encoding="utf-8", newline=None)
    return path.open("rt", encoding="utf-8", newline=None)


def fasta_lengths(
    path: Path,
    *,
    allow_empty: bool = False,
) -> OrderedDict[str, int]:
    if not path.is_file():
        raise UserError(f"contig FASTA does not exist: {path}")
    if path.stat().st_size == 0:
        if allow_empty:
            return OrderedDict()
        raise UserError(f"contig FASTA is empty: {path}")
    lengths: OrderedDict[str, int] = OrderedDict()
    identifier: Optional[str] = None
    length = 0

    def finish() -> None:
        nonlocal identifier, length
        if identifier is None:
            return
        if length == 0:
            raise UserError(f"{path}: empty sequence for {identifier}")
        lengths[identifier] = length

    try:
        with open_text(path) as handle:
            for line_number, raw_line in enumerate(handle, start=1):
                line = raw_line.rstrip("\r\n")
                if line.startswith(">"):
                    finish()
                    fields = line[1:].split()
                    if not fields:
                        raise UserError(
                            f"{path}: empty FASTA header at line {line_number}"
                        )
                    identifier = fields[0]
                    if identifier in lengths:
                        raise UserError(
                            f"{path}: duplicate contig ID {identifier!r}"
                        )
                    length = 0
                elif not line:
                    continue
                elif identifier is None:
                    raise UserError(
                        f"{path}: sequence before first header at line "
                        f"{line_number}"
                    )
                else:
                    length += len("".join(line.split()))
    except (OSError, EOFError, gzip.BadGzipFile) as error:
        raise UserError(f"cannot read FASTA {path}: {error}") from error
    finish()
    if not lengths and not allow_empty:
        raise UserError(f"{path}: no FASTA records")
    return lengths


@dataclass(frozen=True)
class DepthInput:
    path: Path


def parse_depth_inputs(values: Sequence[str | Path]) -> tuple[DepthInput, ...]:
    inputs = tuple(DepthInput(Path(value).expanduser().resolve()) for value in values)
    if not inputs:
        raise UserError("at least one --coverage input is required")
    return inputs


def resolve_coverage_inputs(args: argparse.Namespace) -> None:
    """Route one homogeneous set of coverage files to its native backend."""
    inputs = parse_depth_inputs(args.coverage)
    kinds = []
    for item in inputs:
        path = item.path
        if not path.is_file() or path.stat().st_size == 0:
            raise UserError(f"coverage file does not exist or is empty: {path}")
        with path.open("rb") as handle:
            prefix = handle.read(4)
        if prefix[:2] == b"\x1f\x8b":
            with gzip.open(path, "rb") as handle:
                prefix = handle.read(4)
        is_bam = prefix == b"BAM\x01" or path.suffix.lower() == ".bam"
        kinds.append("bam" if is_bam else "table")
    if len(set(kinds)) != 1:
        raise UserError("--coverage cannot mix BAM files and coverage tables in one run")
    args.bam = [item.path for item in inputs] if kinds[0] == "bam" else None
    args.depth = args.coverage if kinds[0] == "table" else None


def _depth_file_label(path: Path) -> str:
    name = path.name
    if name.endswith(".gz"):
        name = name[:-3]
    for suffix in (".tsv", ".txt", ".tab"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
            break
    if not name:
        raise UserError(f"cannot infer coverage name from depth path: {path}")
    return name


def _nonnegative_depth_value(
    value: str,
    *,
    source: Path,
    identifier: str,
    column: str,
    line_number: int,
) -> float:
    try:
        parsed = float(value)
    except ValueError as error:
        raise UserError(
            f"{source}: invalid numeric value for {column!r}, contig "
            f"{identifier!r}, line {line_number}: {value!r}"
        ) from error
    if not math.isfinite(parsed) or parsed < 0:
        raise UserError(
            f"{source}: coverage values must be finite and non-negative; "
            f"column={column!r}, contig={identifier!r}, line={line_number}"
        )
    return parsed


def normalized_depth_rows(
    inputs: Sequence[DepthInput],
    contig_lengths: OrderedDict[str, int],
    sample: str,
    **column_options,
) -> tuple[list[str], list[list[str]], dict[str, object]]:
    """Select FASTA IDs from full-assembly tables, preserving means/variances."""

    if not inputs:
        raise UserError("at least one depth input is required")
    generic_names = {
        "depth",
        "mean_depth",
        "abundance",
        "coverage",
        "totalAvgDepth",
    }
    coverage_names: list[str] = []
    coverage_source_names: list[str] = []
    variance_available: list[bool] = []
    source_metadata: list[dict[str, object]] = []
    combined_values: dict[str, list[str]] = {
        identifier: [] for identifier in contig_lengths
    }
    combined_numeric: dict[str, list[float]] = {
        identifier: [] for identifier in contig_lengths
    }
    combined_variances: dict[str, list[str]] = {
        identifier: [] for identifier in contig_lengths
    }
    preserved_total: Optional[dict[str, str]] = None
    extra_rows = 0

    for depth_input in inputs:
        source = depth_input.path
        if not source.is_file() or source.stat().st_size == 0:
            raise UserError(f"depth table does not exist or is empty: {source}")
        try:
            with open_text(source) as handle:
                raw_header = handle.readline()
                if not raw_header:
                    raise UserError(f"depth table is empty: {source}")
                columns = raw_header.rstrip("\r\n").split("\t")
                try:
                    schema = identify_depth_schema(columns, sample, **column_options)
                except DepthSchemaError as error:
                    raise UserError(f"{source}: {error}") from error
                if len(inputs) > 1 and (schema.source_format in {
                    "generic_single_coverage", "jgi_total_only",
                } or (schema.source_format == "custom_coverage" and schema.coverage_column_count == 1)):
                    source_name = schema.source_coverage_names[0]
                    override_name = (
                        _depth_file_label(source)
                        if source_name in generic_names or schema.source_format == "custom_coverage"
                        else source_name
                    )
                else:
                    override_name = None
                if override_name is not None:
                    try:
                        schema = identify_depth_schema(
                            columns,
                            sample,
                            single_coverage_name=override_name,
                            **column_options,
                        )
                    except DepthSchemaError as error:
                        raise UserError(f"{source}: {error}") from error
                prospective_names = [*coverage_names, *schema.coverage_names]
                prospective_jgi_columns = [
                    "contigName",
                    "contigLen",
                    "totalAvgDepth",
                ]
                for name in prospective_names:
                    prospective_jgi_columns.extend((name, f"{name}-var"))
                collisions = sorted(
                    {
                        name
                        for name in prospective_jgi_columns
                        if prospective_jgi_columns.count(name) > 1
                    }
                )
                if collisions:
                    raise UserError(
                        "coverage names must remain unique after JGI "
                        "normalization; collision(s): "
                        + ", ".join(collisions)
                    )

                observed: dict[
                    str, tuple[list[str], list[float], list[str], Optional[str]]
                ] = {}
                seen_ids: set[str] = set()
                source_extra_rows = 0
                for line_number, raw_line in enumerate(handle, start=2):
                    row = raw_line.rstrip("\r\n")
                    if not row:
                        continue
                    fields = row.split("\t")
                    if len(fields) != len(schema.columns):
                        raise UserError(
                            f"{source}: depth row {line_number} has "
                            f"{len(fields)} fields; expected {len(schema.columns)}"
                        )
                    identifier = fields[schema.id_index]
                    if not identifier:
                        raise UserError(
                            f"{source}: empty contig ID at line {line_number}"
                        )
                    if identifier in seen_ids:
                        raise UserError(
                            f"{source}: duplicate depth ID {identifier!r}"
                        )
                    seen_ids.add(identifier)
                    values = [fields[index] for index in schema.coverage_indices]
                    numeric_values = [
                        _nonnegative_depth_value(
                            value,
                            source=source,
                            identifier=identifier,
                            column=name,
                            line_number=line_number,
                        )
                        for name, value in zip(schema.coverage_names, values)
                    ]
                    variance_values: list[str] = []
                    for name, variance_index in zip(
                        schema.coverage_names,
                        schema.variance_indices,
                    ):
                        if variance_index is None:
                            variance_values.append("NA")
                            continue
                        variance_text = fields[variance_index]
                        _nonnegative_depth_value(
                            variance_text,
                            source=source,
                            identifier=identifier,
                            column=f"{name}-var",
                            line_number=line_number,
                        )
                        variance_values.append(variance_text)
                    total_text: Optional[str] = None
                    if schema.total_index is not None:
                        total_text = fields[schema.total_index]
                        _nonnegative_depth_value(
                            total_text,
                            source=source,
                            identifier=identifier,
                            column="totalAvgDepth",
                            line_number=line_number,
                        )
                    if schema.length_index is not None:
                        try:
                            observed_length = int(fields[schema.length_index])
                        except ValueError as error:
                            raise UserError(
                                f"{source}: invalid contigLen for "
                                f"{identifier!r} at line {line_number}"
                            ) from error
                    else:
                        observed_length = None
                    if identifier not in contig_lengths:
                        source_extra_rows += 1
                        continue
                    if (
                        observed_length is not None
                        and observed_length != contig_lengths[identifier]
                    ):
                        raise UserError(
                            f"{source}: length mismatch for {identifier!r}: "
                            f"FASTA={contig_lengths[identifier]}, "
                            f"depth={observed_length}"
                        )
                    observed[identifier] = (
                        values,
                        numeric_values,
                        variance_values,
                        total_text,
                    )
        except (OSError, EOFError, gzip.BadGzipFile) as error:
            raise UserError(f"cannot read depth table {source}: {error}") from error

        missing = [
            identifier for identifier in contig_lengths if identifier not in observed
        ]
        if missing:
            raise UserError(
                f"{source}: {len(missing)} FASTA contigs lack depth; "
                f"examples={missing[:10]}"
            )
        if len(inputs) == 1 and schema.total_index is not None:
            preserved_total = {
                identifier: observed[identifier][3] or "0"
                for identifier in contig_lengths
            }
        for identifier in contig_lengths:
            values, numeric_values, variances, _ = observed[identifier]
            combined_values[identifier].extend(values)
            combined_numeric[identifier].extend(numeric_values)
            combined_variances[identifier].extend(variances)
        variance_available.extend(i is not None for i in schema.variance_indices)
        coverage_names.extend(schema.coverage_names)
        coverage_source_names.extend(schema.source_coverage_names)
        extra_rows += source_extra_rows
        source_metadata.append(
            {
                "path": str(source),
                "format": schema.source_format,
                "coverage_source_columns": list(schema.source_coverage_names),
                "coverage_columns": list(schema.coverage_names),
                "coverage_column_count": schema.coverage_column_count,
                "extra_depth_rows_ignored": source_extra_rows,
                "selected_contig_rows": len(observed),
            }
        )

    header_fields = ["contigName", "contigLen", "totalAvgDepth"]
    for name in coverage_names:
        header_fields.extend((name, f"{name}-var"))
    rows = []
    for identifier, length in contig_lengths.items():
        if preserved_total is not None:
            total_text = preserved_total[identifier]
        elif len(combined_values[identifier]) == 1:
            total_text = combined_values[identifier][0]
        else:
            total_text = format(math.fsum(combined_numeric[identifier]), ".17g")
        fields = [identifier, str(length), total_text]
        for value, variance in zip(
            combined_values[identifier],
            combined_variances[identifier],
        ):
            fields.extend((value, variance))
        rows.append(fields)

    total_policy = (
        "provided"
        if preserved_total is not None
        else "sum_of_coverage_columns"
    )
    return header_fields, rows, {
        "contigs": len(contig_lengths),
        "bp": sum(contig_lengths.values()),
        "extra_depth_rows_ignored": extra_rows,
        "depth_source_count": len(inputs),
        "depth_sources": source_metadata,
        "coverage_source_columns": coverage_source_names,
        "coverage_columns": coverage_names,
        "coverage_column_count": len(coverage_names),
        "variance_available": variance_available,
        "total_avg_depth_policy": total_policy,
    }


def normalized_depth_inputs(inputs, contig_lengths, sample, **column_options):
    """Text adapter for callers that need a serialized table."""
    header, rows, summary = normalized_depth_rows(inputs, contig_lengths, sample, **column_options)
    text = "\t".join(header) + "\n" + "".join("\t".join(row) + "\n" for row in rows)
    return text, summary


def normalized_depth_text(
    source: Path,
    contig_lengths: OrderedDict[str, int],
    sample: str,
) -> tuple[str, dict[str, object]]:
    """Backward-compatible one-file normalization helper."""

    return normalized_depth_inputs(
        (DepthInput(source.resolve()),),
        contig_lengths,
        sample,
    )


def parse_choices(
    value: str,
    supported: Sequence[str],
    label: str,
) -> tuple[str, ...]:
    if value == "all":
        return tuple(supported)
    values = tuple(part.strip().lower() for part in value.split(",") if part.strip())
    if not values:
        raise UserError(f"{label} is empty")
    unknown = sorted(set(values).difference(supported))
    duplicates = sorted({item for item in values if values.count(item) > 1})
    if unknown:
        raise UserError(f"unsupported {label}: {unknown}")
    if duplicates:
        raise UserError(f"duplicate {label}: {duplicates}")
    return values


def executable(name: str, label: str) -> str:
    resolved = shutil.which(name)
    if resolved is None:
        raise UserError(f"{label} executable not found on PATH: {name}")
    return resolved


def directory_state(path: Optional[Path], required: Sequence[str]) -> dict[str, object]:
    if path is None:
        return {"ok": False, "path": None, "error": "not configured"}
    resolved = path.expanduser().resolve()
    missing = [
        relative
        for relative in required
        if not (resolved / relative).exists()
    ]
    return {
        "ok": resolved.is_dir() and not missing,
        "path": str(resolved),
        "missing": missing,
        "error": (
            ""
            if resolved.is_dir() and not missing
            else "directory missing or incomplete"
        ),
    }


def require_remag_cuda() -> dict[str, object]:
    """Probe the same Conda environment used by the native ReMAG backend."""
    environment = environment_value("REMAG_ENV")
    if environment:
        command = [environment_value("CONDA_EXE") or "conda", "run", "--no-capture-output",
                   "-p" if environment.startswith("/") else "-n", environment, "python"]
    else:
        from run_seeded_vamb import console_interpreter

        interpreter = console_interpreter(Path(executable("remag", "ReMAG")))
        command = [str(interpreter or sys.executable)]
    probe = (
        "import json, sys, torch; from remag.utils import get_torch_device; "
        "device = get_torch_device(); "
        "info = dict(device=device.type, torch_version=torch.__version__, "
        "cuda_version=torch.version.cuda, "
        "gpu_name=torch.cuda.get_device_name(0) if device.type == 'cuda' else None); "
        "print(json.dumps(info)); "
        "sys.exit(0 if device.type == 'cuda' and torch.cuda.is_available() else 2)"
    )
    try:
        result = subprocess.run([*command, "-c", probe], text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                check=False, timeout=180)
        if result.returncode:
            detail = (result.stderr.strip() or result.stdout.strip())[-800:]
            raise UserError("--gpu T requires CUDA-enabled PyTorch and a visible allocated "
                            f"NVIDIA GPU in the ReMAG environment. Probe failed: {detail}")
        info = json.loads(result.stdout)
        if info.get("device") != "cuda":
            raise UserError("--gpu T: ReMAG did not select CUDA")
        return info
    except (OSError, subprocess.TimeoutExpired, ValueError) as error:
        raise UserError(f"--gpu T CUDA check failed: {error}") from error


def require_vamb_cuda() -> dict[str, object]:
    """Check CUDA using the interpreter that will run VAMB."""
    from run_seeded_vamb import console_interpreter

    vamb = Path(executable("vamb", "VAMB"))
    interpreter = console_interpreter(vamb) or Path(sys.executable)
    probe = (
        "import json, sys, torch; "
        "available = torch.cuda.is_available(); "
        "print(json.dumps(dict(device='cuda' if available else 'cpu', "
        "torch_version=torch.__version__, cuda_version=torch.version.cuda, "
        "gpu_name=torch.cuda.get_device_name(0) if available else None))); "
        "sys.exit(0 if available else 2)"
    )
    try:
        result = subprocess.run([str(interpreter), "-c", probe], text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                check=False, timeout=180)
        if result.returncode:
            detail = (result.stderr.strip() or result.stdout.strip())[-800:]
            raise UserError(f"--gpu T requires CUDA in the VAMB environment: {detail}")
        info = json.loads(result.stdout)
        if info.get("device") != "cuda":
            raise UserError("--gpu T: VAMB CUDA is unavailable")
        return info
    except (OSError, subprocess.TimeoutExpired, ValueError) as error:
        raise UserError(f"--gpu T VAMB CUDA check failed: {error}") from error


def read_tsv(path: Path) -> tuple[list[str], list[dict[str, str]]]:
    with path.open("rt", encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        return list(reader.fieldnames or []), list(reader)


def write_tsv(
    path: Path,
    columns: Sequence[str],
    rows: Iterable[dict[str, object]],
) -> None:
    lines = ["\t".join(columns) + "\n"]
    lines.extend(
        "\t".join(
            str(row.get(column, ""))
            .replace("\t", " ")
            .replace("\r", " ")
            .replace("\n", " ")
            for column in columns
        )
        + "\n"
        for row in rows
    )
    atomic_text(path, "".join(lines))


def qc_metrics(
    completeness: str,
    contamination: str,
    *,
    min_completeness: float,
    max_contamination: float,
    contamination_penalty: float,
) -> tuple[str, str]:
    try:
        complete_value = float(completeness)
        contamination_value = float(contamination)
    except (TypeError, ValueError):
        return "no", ""
    if not (
        math.isfinite(complete_value)
        and math.isfinite(contamination_value)
        and 0.0 <= complete_value <= 100.0
        and contamination_value >= 0.0
    ):
        return "no", ""
    passed = (
        complete_value >= min_completeness
        and contamination_value <= max_contamination
    )
    quality_score = complete_value - contamination_penalty * contamination_value
    return ("yes" if passed else "no"), f"{quality_score:g}"


def binner_parameters(args: argparse.Namespace) -> dict[str, list[str]]:
    parsed = {}
    for binner in BINNERS:
        label = f"--{binner}-parameters"
        try:
            tokens = shlex.split(getattr(args, f"{binner}_parameters"))
        except ValueError as error:
            raise UserError(f"{label}: {error}") from error
        if tokens and binner not in args.binner_list:
            raise UserError(f"{label} requires {binner} in --binners")
        protected = (*MANAGED_BINNER_OPTIONS[binner], "-h", "--help", "--version")
        if binner == "concoct":
            protected += ("-v",)
        for token in tokens:
            if "\x00" in token or token == "--":
                raise UserError(f"{label}: invalid parameter {token!r}")
            if token.startswith("-") and not token.startswith("--") and len(token) > 2 and token[1:3].isalpha():
                raise UserError(f"{label}: write short options and their values separately: {token!r}")
            option = token.split("=", 1)[0]
            if any(
                (flag.startswith(option) if option.startswith("--")
                 else token.startswith(flag) if len(flag) == 2 else False)
                for flag in protected
            ):
                raise UserError(
                    f"{label}: {option} is managed by EBP; use its public parameters instead"
                )
        parsed[binner] = tokens
    return parsed


def validate_args(args: argparse.Namespace) -> None:
    if not args.coverage and not args.bins:
        raise UserError("provide --coverage, --bins, or both")
    args.input_mode = "combined" if args.coverage and args.bins else ("binning" if args.coverage else "bins")
    args.binner_list = parse_choices(args.binners, BINNERS, "binners") if args.coverage else ()
    args.bin_sources = {}
    if args.bins:
        from import_bins import discover_bin_sets
        args.bin_sources = discover_bin_sets(args.bins, reserved=args.binner_list)
    args.source_list = (*args.binner_list, *args.bin_sources)
    if args.coverage:
        if args.contigs is None:
            raise UserError("--contigs is required with --coverage")
        resolve_coverage_inputs(args)
    else:
        if args.contigs or any((args.cov_contig_column, args.cov_mean_column, args.cov_variance_column)):
            raise UserError("--bins alone does not use --contigs or --cov-* options")
        if args.binners != "all" or args.gpu != "F" or any(
            getattr(args, name + "_parameters") for name in BINNERS
        ):
            raise UserError("--bins alone skips binning; omit --binners, --gpu T and binner parameters")
        args.depth, args.bam = [], []
    selectors = (args.cov_contig_column, args.cov_mean_column, args.cov_variance_column)
    if args.bam and any(selectors):
        raise UserError("--cov-* column options apply only to coverage tables, not BAM files")
    if any(selectors) and not (args.cov_contig_column and args.cov_mean_column):
        raise UserError("custom tables require --cov-contig-column and --cov-mean-column together")
    args.binner_parameters = binner_parameters(args)
    if args.gpu == "T" and not {"remag", "vamb"}.intersection(args.binner_list):
        raise UserError("--gpu T requires remag or vamb in --binners")
    args.qc_list = parse_choices(args.qc_tools, QC_TOOLS, "QC tools")
    if args.qc_decision not in args.qc_list:
        raise UserError("--qc-decision must also occur in --qc-tools")
    if args.min_retain_size < 0:
        raise UserError("--min-retain-size must be non-negative")
    if args.min_selection_size < 0:
        raise UserError("--min-selection-size must be non-negative")
    if args.min_selection_size < args.min_retain_size:
        raise UserError(
            "--min-selection-size must be >= --min-retain-size"
        )
    if not 0.0 < args.min_overlap <= 1.0:
        raise UserError("--min-overlap must be in (0, 1]")
    if (
        not math.isfinite(args.contamination_penalty)
        or args.contamination_penalty < 0
    ):
        raise UserError("--contamination-penalty must be non-negative")
    if (
        not math.isfinite(args.min_selection_completeness)
        or not 0.0 <= args.min_selection_completeness <= 100.0
    ):
        raise UserError("--min-selection-completeness must be in [0, 100]")
    if (
        not math.isfinite(args.max_selection_contamination)
        or not 0.0 <= args.max_selection_contamination <= 100.0
    ):
        raise UserError("--max-selection-contamination must be in [0, 100]")
    if args.threads < 1:
        raise UserError("--threads must be positive")
    if not 1 <= args.random_seed <= 4294967295:
        raise UserError("--random-seed must be positive and at most 4294967295")
    if args.min_input_length < 1:
        raise UserError("--min-input-length must be positive")
    if args.sample in {".", ".."} or not re.fullmatch(r"[A-Za-z0-9._-]+", args.sample):
        raise UserError(
            "--sample must contain only letters, digits, dot, underscore, hyphen"
        )


def depth_column_options(args):
    return dict(contig_column=args.cov_contig_column,
                coverage_columns=[x.strip() for x in args.cov_mean_column.split(",")] if args.cov_mean_column else None,
                variance_columns=[x.strip() for x in args.cov_variance_column.split(",")] if args.cov_variance_column else None)


def validate_inputs(args: argparse.Namespace) -> dict[str, object]:
    contigs = args.contigs.resolve() if args.contigs else None
    depth_inputs = parse_depth_inputs(args.depth) if args.depth else ()
    from import_bins import inspect_bin_sets
    bin_inputs, imported_lengths = inspect_bin_sets(args.bin_sources)
    # Keep validated data only in this invocation, never in run.json or a disk cache.
    paths = ([contigs] if args.coverage else []) + [item.path for item in depth_inputs]
    args._input_states = {p: (p.stat().st_size, p.stat().st_mtime_ns) for p in paths}
    args._normalized_depth = None
    lengths = fasta_lengths(contigs, allow_empty=True) if args.coverage else imported_lengths
    args._contig_lengths = lengths
    eligible_lengths = OrderedDict(
        (identifier, length)
        for identifier, length in lengths.items()
        if length >= args.min_input_length
    )
    bam_summary = {}
    if not args.coverage:
        eligible_lengths = lengths
        depth_bytes = None
        depth_summary = dict(contigs=0, depth_source_count=0, depth_sources=[],
                             coverage_source_columns=[], coverage_columns=[],
                             coverage_column_count=0, variance_available=[],
                             total_avg_depth_policy=None)
    elif args.bam:
        bam_summary = validate_bams(args.bam, lengths, open_text(contigs),
                                    environment_value("METABAT2_ENV"),
                                    environment_value("CONDA_EXE") or "conda")
        if bam_summary["reference_sequence_check"] != "M5_verified":
            note("BAM reference M5 is absent for some contigs: ID/length checked; "
                 "you must ensure the FASTA comes from the mapped assembly")
        names = [Path(item["path"]).stem for item in bam_summary["bam_inputs"]]
        depth_bytes = None
        depth_summary = dict(contigs=len(lengths), depth_source_count=0, depth_sources=[],
                             coverage_source_columns=names, coverage_columns=names,
                             coverage_column_count=len(names), variance_available=[True]*len(names),
                             total_avg_depth_policy="native_JGI")
    else:
        header, rows, depth_summary = normalized_depth_rows(
            depth_inputs, lengths, args.sample, **depth_column_options(args))
        args._normalized_depth = (header, rows)
        depth_bytes = len("\t".join(header).encode("utf-8")) + 1
        depth_bytes += sum(sum(len(value.encode("utf-8")) for value in row) + len(row) for row in rows)
        variance = depth_summary["variance_available"]
        if "metabat2" in args.binner_list and any(variance) and not all(variance):
            raise UserError("MetaBAT2 cannot mix observed and missing variance; "
                            "provide all variances or omit metabat2")
    eukcc_db_value = args.eukcc_db or environment_value("EUKCC_DB")
    busco_db_value = args.busco_db or environment_value("BUSCO_DB")
    if "eukcc" in args.qc_list:
        eukcc_state = directory_state(
            Path(eukcc_db_value) if eukcc_db_value else None,
            (),
        )
        if not eukcc_state["ok"]:
            raise UserError(
                "EukCC needs a valid --eukcc-db or "
                "EUKBINPICKER_EUKCC_DB"
            )
    if "busco" in args.qc_list:
        busco_state = directory_state(
            Path(busco_db_value) if busco_db_value else None,
            ("dataset.cfg", "hmms"),
        )
        if not busco_state["ok"]:
            raise UserError(
                "BUSCO needs an unpacked --busco-db or "
                "EUKBINPICKER_BUSCO_DB containing dataset.cfg and hmms/"
            )
    qc_references = {
        "eukcc_db": (
            str(Path(eukcc_db_value).expanduser().resolve())
            if "eukcc" in args.qc_list and eukcc_db_value
            else None
        ),
        "busco_db": (
            str(Path(busco_db_value).expanduser().resolve())
            if "busco" in args.qc_list and busco_db_value
            else None
        ),
    }
    return {
        "sample": args.sample,
        "study": INTERNAL_STUDY,
        "contigs": len(lengths),
        "bp": sum(lengths.values()),
        "eligible_contigs": len(eligible_lengths),
        "eligible_bp": sum(eligible_lengths.values()),
        "depth_rows": depth_summary["contigs"],
        "normalized_depth_bytes": depth_bytes,
        "input_mode": args.input_mode,
        "bin_inputs": bin_inputs if args.bins else [],
        "coverage_input": ("bam" if args.bam else "table") if args.coverage else None,
        "variance_available": depth_summary["variance_available"],
        "column_options": depth_column_options(args),
        **bam_summary,
        "depth_source_count": depth_summary["depth_source_count"],
        "depth_sources": depth_summary["depth_sources"],
        "coverage_source_columns": depth_summary[
            "coverage_source_columns"
        ],
        "coverage_columns": depth_summary["coverage_columns"],
        "coverage_column_count": depth_summary["coverage_column_count"],
        "total_avg_depth_policy": depth_summary[
            "total_avg_depth_policy"
        ],
        "binners": list(args.source_list),
        "binner_parameters": args.binner_parameters,
        "gpu": args.gpu,
        "qc_tools": list(args.qc_list),
        "decision_qc": args.qc_decision,
        "random_seed": args.random_seed,
        "contamination_source": (
            "eukcc_contamination"
            if args.qc_decision == "eukcc"
            else "busco_duplicated"
        ),
        "min_completeness": args.min_selection_completeness,
        "max_contamination": args.max_selection_contamination,
        "contamination_penalty": args.contamination_penalty,
        "qc_references": qc_references,
        "retain_min_bin_bp": args.min_retain_size,
        "qc_min_bin_bp": args.min_selection_size,
        "min_contig_bp": args.min_input_length,
        "overlap_threshold": args.min_overlap,
    }


def add_workflow_arguments(parser: argparse.ArgumentParser) -> None:
    workflow = parser.add_argument_group("workflow selection")
    workflow.add_argument(
        "--binners",
        default="all",
        metavar="LIST",
        help=(
            "all or a comma-separated subset of "
            "remag,concoct,metabat2,vamb (default: all four)"
        ),
    )
    workflow.add_argument(
        "--gpu", choices=("T", "F"), default="F",
        help="T: require CUDA for selected ReMAG/VAMB; F: run all tools on CPU (default: F)",
    )
    for binner in BINNERS:
        workflow.add_argument(
            f"--{binner}-parameters", default="", metavar="TEXT",
            help=f"quoted native {binner} options; EBP-managed options cannot be overridden (default: none)",
        )
    workflow.add_argument(
        "--qc-tools",
        default="eukcc",
        metavar="LIST",
        help="eukcc, busco, eukcc,busco, or all (default: eukcc)",
    )
    workflow.add_argument(
        "--qc-decision",
        choices=QC_TOOLS,
        default="eukcc",
        help=(
            "QC tool controlling final eligibility and ordering; it must "
            "also occur in --qc-tools (default: eukcc)"
        ),
    )

    references = parser.add_argument_group("reference databases")
    references.add_argument(
        "--eukcc-db",
        metavar="DIR",
        help="EukCC database; defaults to EUKBINPICKER_EUKCC_DB",
    )
    references.add_argument(
        "--busco-db",
        metavar="DIR",
        help=(
            "unpacked BUSCO lineage directory containing dataset.cfg and "
            "hmms/; defaults to EUKBINPICKER_BUSCO_DB"
        ),
    )


def add_run_arguments(parser: argparse.ArgumentParser) -> None:
    required = parser.add_argument_group("input and output")
    required.add_argument(
        "--sample",
        required=True,
        help="sample ID using letters, digits, dot, underscore, or hyphen",
    )
    required.add_argument(
        "--contigs",
        type=Path,
        metavar="FASTA",
        help="input contig FASTA with unique record IDs; required with --coverage",
    )
    inputs = required
    inputs.add_argument(
        "--coverage",
        action="extend",
        nargs="+",
        metavar="FILE",
        help=(
            "coverage table(s) or coordinate-sorted indexed BAM(s); "
            "full-assembly inputs are matched to the supplied FASTA; "
            "accepts multiple files and repeated --coverage; do not mix formats"
        ),
    )
    inputs.add_argument(
        "--bins", type=Path, nargs="+", action="extend", metavar="DIR",
        help="existing bin directories from the same assembly; use alone or add to --contigs and --coverage",
    )
    columns = parser.add_argument_group("custom coverage table columns")
    columns.add_argument("--cov-contig-column", metavar="NAME")
    columns.add_argument("--cov-mean-column", metavar="A,B", help="comma-separated mean columns in sample order")
    columns.add_argument("--cov-variance-column", metavar="A_VAR,B_VAR", help="optional observed variance columns in the same sample order")
    required.add_argument(
        "--output",
        required=True,
        type=Path,
        metavar="DIR",
        help="output directory",
    )

    add_workflow_arguments(parser)

    filtering = parser.add_argument_group("input filtering")
    filtering.add_argument(
        "--min-input-length",
        type=int,
        default=1500,
        metavar="INT",
        help="minimum contig length entering binning, inclusive (default: 1500)",
    )
    filtering.add_argument(
        "--min-retain-size",
        type=int,
        default=200_000,
        metavar="INT",
        help="minimum retained bin size in bp; 0 disables this filter (default: 200000)",
    )
    filtering.add_argument(
        "--min-selection-size",
        type=int,
        default=500_000,
        metavar="INT",
        help="minimum retained-bin size in bp entering QC and representative selection (default: 500000)",
    )

    quality = parser.add_argument_group("quality filtering")
    quality.add_argument(
        "--min-selection-completeness",
        type=float,
        default=0.0,
        metavar="FLOAT",
        help="minimum completeness percentage for selection, inclusive; valid QC required (default: 0)",
    )
    quality.add_argument(
        "--max-selection-contamination",
        type=float,
        default=100.0,
        metavar="FLOAT",
        help=(
            "maximum final contamination percentage, inclusive; BUSCO uses "
            "duplicated percentage as the contamination proxy (default: 100)"
        ),
    )
    quality.add_argument(
        "--contamination-penalty",
        type=float,
        default=5.0,
        metavar="FLOAT",
        help=(
            "penalty in completeness - penalty * contamination "
            "(default: 5.0)"
        ),
    )

    deduplication = parser.add_argument_group("deduplication")
    deduplication.add_argument(
        "--min-overlap",
        type=float,
        default=0.50,
        metavar="FLOAT",
        help=(
            "inclusive shared_contig_bp/min(bin_a_bp,bin_b_bp) threshold "
            "for cross-binner overlap (default: 0.50)"
        ),
    )

    execution = parser.add_argument_group("execution")
    execution.add_argument(
        "--threads",
        type=int,
        default=4,
        metavar="INT",
        help="threads supplied to each external tool (default: 4)",
    )
    execution.add_argument(
        "--random-seed",
        type=int,
        default=DEFAULT_RANDOM_SEED,
        metavar="INT",
        help=(
            "positive random seed supplied to seed-aware binners "
            f"(default: {DEFAULT_RANDOM_SEED})"
        ),
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=CLI_NAME,
        allow_abbrev=False,
        add_help=False,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Input modes:\n"
            "  From contigs: --contigs FASTA --coverage FILE [FILE ...]\n"
            "  From existing bins: --bins DIR [DIR ...]\n"
            "  From both: --contigs FASTA --coverage FILE [FILE ...] --bins DIR [DIR ...]\n\n"
            "All modes require --sample and --output, plus a database for each selected QC tool.\n"
            "Selected FASTA files: OUTPUT/3_selection/bins/"
        ),
        description=(
            "Recover eukaryotic genome bins with complementary binning methods. "
            "Bin contigs, import existing bin sets, or combine both."
        ),
    )
    parser.add_argument("--help", action="help", help="show this help message and exit")
    parser.add_argument("--version", action="version", version=VERSION)
    add_run_arguments(parser)
    return parser


def parse_arguments(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    """Accept quoted native options as one value, including a lone --flag."""
    parser = build_parser()
    tokens = list(sys.argv[1:] if argv is None else argv)
    forwarded = {f"--{name}-parameters" for name in BINNERS}
    public = set(parser._option_string_actions)
    normalized = []
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token in forwarded and index + 1 < len(tokens):
            value = tokens[index + 1]
            if value.split("=", 1)[0] not in public:
                normalized.append(f"{token}={value}")
                index += 2
                continue
        normalized.append(token)
        index += 1
    return parser.parse_args(normalized)


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_arguments(argv)
    try:
        from workflow import run
        run(sys.modules[__name__], args)
    except KeyboardInterrupt:
        print("eukbinpicker: interrupted; rerun the same command to resume", file=sys.stderr)
        return 130
    except (UserError, OSError, ValueError) as error:
        print(f"{CLI_NAME}: error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
